#!/usr/bin/env bash
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"
# These flags suppress Git's comparisons, so reject them without changing the
# index. A normal diff can then establish which working-tree inputs are staged.
git ls-files -v -z |
    while IFS= read -r -d '' entry; do
        case "${entry:0:1}" in
            [a-z]|S)
                printf 'Pre-commit rejected: index flags suppress comparisons for %q.\n' \
                    "${entry:2}" >&2
                printf '%s\n' 'Clear assume-unchanged/skip-worktree flags before committing.' >&2
                exit 1
                ;;
        esac
    done
if ! git diff --quiet --ignore-submodules=none --; then
    printf '%s\n' 'Pre-commit rejected: tracked working tree differs from the index.' \
        'Stage or restore tracked changes before committing.' >&2
    exit 1
fi

# Require new check inputs to be staged, honoring Git's standard ignore rules.
# The check suite still reads the working tree, including some ignored files.
git ls-files --others --exclude-standard -z -- src tests docs .githooks \
    ':(top,glob)*.zig' ':(top,glob)*.zon' ':(top,glob)*.sh' \
    ':(top,glob)*.py' ':(top,glob)*.md' ':(top,glob)*.json' \
    ':(top,glob)*.yaml' ':(top,glob)*.yml' |
    while IFS= read -r -d '' path; do
        printf 'Pre-commit rejected: untracked check input %q; stage it before committing.\n' \
            "$path" >&2
        exit 1
    done

exec ./check.sh
